{
  "name": "@haiilo/catalyst-angular-workspace",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test catalyst --browsers ChromiumHeadless && ng test catalyst-formly --browsers ChromiumHeadless",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "clean": "rm -rf ./.angular ./dist",
    "reset": "rm -rf ./.angular ./dist ./node_modules"
  },
  "dependencies": {
    "@angular/cdk": "22.2.7",
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@haiilo/catalyst-icons": "^1.0.6",
    "@ngx-formly/core": "7.0.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.7",
    "@angular/cli": "22.2.7",
    "@angular/compiler-cli": "22.2.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@vitest/browser-playwright": "4.1.8",
    "@vitest/coverage-v8": "4.1.8",
    "@vitest/ui": "4.1.8",
    "esbuild-plugin-ignore": "^1.1.1",
    "jsdom": "^27.4.0",
    "ng-packagr": "22.3.0",
    "playwright": "^1.57.0",
    "prettier": "3.7.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
